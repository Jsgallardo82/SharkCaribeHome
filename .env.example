# ============================================================
#  Variables de entorno · Shark Caribe
#
#  Copia este archivo como .env.local y rellena los valores.
#  .env.local ya está ignorado por git (*.local en .gitignore),
#  así que tus llaves no se van a subir al repo.
#
#  Los valores están en el dashboard de Supabase:
#    Project Settings → API
#      · Project URL      →  VITE_SUPABASE_URL
#      · anon / public key →  VITE_SUPABASE_ANON_KEY
#
#  OJO: usa la llave "anon", NUNCA la "service_role".
#  Todo lo que lleve el prefijo VITE_ termina dentro del bundle
#  que se descarga el navegador, así que es público por diseño.
#  La llave anon está pensada para eso; la service_role no.
# ============================================================

VITE_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# ------------------------------------------------------------
#  Wompi (pago de entradas)
#  Dashboard: https://comercios.wompi.co → Desarrolladores
#  Usa pub_test_… en Sandbox y pub_prod_… en producción.
#
#  El botón "Inscribirse e ir a pagar" solo aparece si:
#    1) hay VITE_WOMPI_PUBLIC_KEY, y
#    2) VITE_WOMPI_PAYMENTS_ENABLED=true
#  Déjalo en false/omitido hasta que Wompi active Producción.
# ------------------------------------------------------------
VITE_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx
VITE_WOMPI_PAYMENTS_ENABLED=false

# ------------------------------------------------------------
#  Secretos de Wompi (NO van aquí)
#  · integrity_secret → private.wompi_secrets (SQL)
#  · WOMPI_EVENTS_SECRET → Supabase Edge Functions Secrets
# ------------------------------------------------------------
